{
  "name": "touch-all",
  "version": "2.1.4",
  "description": "CLI tool to create folder structures from markdown tree representations",
  "keywords": [
    "cli",
    "folders",
    "generator",
    "markdown",
    "structure"
  ],
  "license": "GPL-3.0-or-later",
  "author": "Anton Huz <anton@ahuz.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/anton-huz/touch-all"
  },
  "bin": {
    "touch-all": "dist/slim/touch-all.js"
  },
  "files": [
    "dist/slim",
    "dist/lib"
  ],
  "type": "module",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run .bin/build.ts",
    "check:lint": "oxlint . -c .config/.oxlintrc.json",
    "check:format": "oxfmt . -c .config/.oxfmtrc.json --check",
    "check:ts": "tsc --noEmit",
    "format": "oxfmt . -c .config/.oxfmtrc.json --write",
    "test": "bun test --tsconfig-override ./.config/tsconfig.tests.json"
  },
  "dependencies": {
    "@effect/cli": "0.75.2",
    "effect": "3.21.3"
  },
  "devDependencies": {
    "@effect/platform-node": "0.107.0",
    "@types/bun": "1.3.14",
    "@types/node": "25.9.3",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "url": "https://github.com/anton-huz/touch-all"
}
